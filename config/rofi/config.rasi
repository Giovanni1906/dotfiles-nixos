/* Descarta el tema por defecto de Rofi para que no se mezcle con el nuestro (debe ir primero) */
@theme "/dev/null"

configuration {
    modes: "drun,run,window";
    show-icons: true;
    display-drun: "Apps";
    display-run: "Ejecutar";
    display-window: "Ventanas";
    drun-display-format: "{name}";
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

/* Colores, fuente e iconos de tema/tema.conf (los escribe tema-aplicar) */
@import "tema.rasi"
/* Diseño que usa esas variables; powermenu.sh y atajos.sh lo heredan */
@import "themes/nova.rasi"
