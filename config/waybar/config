// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/pomo",
        "custom/media",
        // "hyprland/workspaces", // Sin tooltip en el número: lo reemplaza group/workspaces
        "group/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        //"idle_inhibitor",
        "pulseaudio",
        //"network",
        "cpu",
        "memory",
        "battery",
        // "keyboard-state",
        "clock",
        "tray",
        "custom/atajos"
    ],
    // Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "active-first": true,
        "active-only": false,
        "on-click": "activate",
    },

    // Números de workspace con tooltip de sus ventanas (scripts/espacios.sh).
    // custom/workspaces no se ve: sigue los eventos de Hyprland y refresca los números con la señal 8.
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspaces",
            "custom/workspace#1", "custom/workspace#2", "custom/workspace#3", "custom/workspace#4", "custom/workspace#5",
            "custom/workspace#6", "custom/workspace#7", "custom/workspace#8", "custom/workspace#9", "custom/workspace#10"
        ]
    },
    "custom/workspaces": {
        "exec": "~/.config/waybar/scripts/espacios.sh escuchar",
        "restart-interval": 5
    },
    "custom/workspace#1":  { "exec": "~/.config/waybar/scripts/espacios.sh 1",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 1" },
    "custom/workspace#2":  { "exec": "~/.config/waybar/scripts/espacios.sh 2",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 2" },
    "custom/workspace#3":  { "exec": "~/.config/waybar/scripts/espacios.sh 3",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 3" },
    "custom/workspace#4":  { "exec": "~/.config/waybar/scripts/espacios.sh 4",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 4" },
    "custom/workspace#5":  { "exec": "~/.config/waybar/scripts/espacios.sh 5",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 5" },
    "custom/workspace#6":  { "exec": "~/.config/waybar/scripts/espacios.sh 6",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 6" },
    "custom/workspace#7":  { "exec": "~/.config/waybar/scripts/espacios.sh 7",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 7" },
    "custom/workspace#8":  { "exec": "~/.config/waybar/scripts/espacios.sh 8",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 8" },
    "custom/workspace#9":  { "exec": "~/.config/waybar/scripts/espacios.sh 9",  "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 9" },
    "custom/workspace#10": { "exec": "~/.config/waybar/scripts/espacios.sh 10", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch workspace 10" },
    
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected  ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped  ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"> </span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
        }
    },
	"tray": {
		"icon-size": 16,
	    "spacing": 10
	},
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}%  ",
        "tooltip": false
    },
    "memory": {
        "format": "{}%  "
    },
    "battery": {
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{capacity}% {icon}",
            "format-charging": "{capacity}% ",
            "format-plugged": "{capacity}% ",
            "format-alt": "{time} {icon}",
            "format-icons": [" ", " ", " ", " ", " "]
        },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
	"network": {
        "format-wifi": "{signalStrength}%  ", 
        "format-ethernet": "{ipaddr}/{cidr}  ",
        "tooltip-format": "Red: {essid} | Mi IP: {ipaddr}",
        "format-linked": "{ifname} (No IP)  ",
        "format-disconnected": "Disconnected ⚠ ",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",          // <-- Aquí añadimos el porcentaje del micro
        "format-source-muted": "Muted  ",        // <-- Y aquí un aviso cuando esté silenciado
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        // Abre o cierra el gestor de volumen (pwvucontrol)
        "on-click": "hyprctl clients | grep -q 'class: com.saivert.pwvucontrol' && hyprctl dispatch closewindow class:com.saivert.pwvucontrol || pwvucontrol"
    },
    "custom/media": {
        "format": " {icon}",
        "return-type": "json",
        "tooltip": true,
        "format-icons": {
            "spotify": " ",
            "zen": " ",      // Zen Browser (donde ves YouTube)
            "firefox": " ",  // Por si usas Firefox
            "chromium": " ",
            "default": "♫"
        },
        "escape": true,
        // Mandamos la canción al "tooltip" en lugar del "text"
        "exec": "playerctl -a metadata --format '{\"text\": \"\", \"alt\": \"{{playerName}}\", \"tooltip\": \"{{artist}} - {{title}}\", \"class\": \"{{playerName}}\"}' -F",
        "on-click": "playerctl play-pause"
    },

    "custom/pomo": {
        "exec": "~/.config/waybar/scripts/pomo.sh",
        "on-click": "~/.config/waybar/scripts/pomo.sh start",
        "on-click-right": "~/.config/waybar/scripts/pomo.sh stop",
        "interval": 1,
        "return-type": "json" // ¡ESTO ES CLAVE!
    },

    "custom/atajos": {
        "format": " \uf11c ", // Icono de teclado (Nerd Font)
        "tooltip-format": "Atajos de teclado (SUPER + F1)",
        "on-click": "~/dotfiles/utils/atajos.sh"
    }
}
